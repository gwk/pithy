// See: https://zed.dev/docs/configuring-zed#settings-files
{
  "file_scan_exclusions": ["**/.DS_Store", "**/__pycache__"],
  "file_scan_inclusions": [
    ".claude",
    "_todo.md",
    "_prompt.md",
    "_plan.md"],
  "tab_size": 2,
  "languages": {
    "CSS": {
      "format_on_save": "off",
    },
    "JSON": {
      "format_on_save": "off",
    },
    "JSONC": {
      "format_on_save": "off",
    },
    "Just": {
      "format_on_save": "off",
    },
    "Python": {
      "formatter": {
        "external": {
          "command": "isort",
          "arguments": ["-", "--stdout"],
        },
      },
    },
    "TOML": {
      "format_on_save": "off",
    },
  },
  "edit_predictions": {
    "disabled_globs": [],
  },
}
