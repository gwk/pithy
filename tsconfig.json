{
  "exclude": [
    "_build/**",
    "_misc/**",
    "dist/**",
    "node/**",
    "pithy_/pithy/web/static/htmx/**",
    "pkg/**",
    "wu_/wu/writeup.js",
  ],
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": true,
    "noImplicitAny": false,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "lib": ["dom", "dom.iterable", "es2020"], // Get intellisense for the available platform APIs.
    "target": "es2022",
  },
}
