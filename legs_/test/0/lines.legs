# Patterns
newline: \n
spaces: \s+
word: $Ascii_Letter+
paren_o: \(
paren_c: \)

# Modes

## main
kinds: newline spaces word paren_o
line_break_kind: newline

## group
kinds: newline spaces word paren_c

# Transitions
main : paren_o :: group : paren_c
