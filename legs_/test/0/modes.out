
'a (bc def) g':
0-1 sym 'a'
1-2 spaces ' '
2-3 paren_open '('
3-5 sym 'bc'
5-6 spaces ' '
6-9 sym 'def'
9-10 paren_close ')'
10-11 spaces ' '
11-12 sym 'g'

'/* comment "contents" () / *. */':
0-2 comment_open '/*'
2-25 comment_contents ' comment "contents" () '
25-26 comment_slash '/'
26-27 comment_contents ' '
27-28 comment_star '*'
28-30 comment_contents '. '
30-32 comment_close '*/'

'\'single quoted.\' "double quoted."':
0-1 sq "'"
1-15 lit_contents 'single quoted.'
15-16 sq "'"
16-17 spaces ' '
17-18 dq '"'
18-32 lit_contents 'double quoted.'
32-33 dq '"'

'/* nested /* comment. */ */':
0-2 comment_open '/*'
2-10 comment_contents ' nested '
10-12 comment_open '/*'
12-22 comment_contents ' comment. '
22-24 comment_close '*/'
24-25 comment_contents ' '
25-27 comment_close '*/'

"'sq \\(a) interpolated.'":
0-1 sq "'"
1-4 lit_contents 'sq '
4-6 lit_interpolate '\\('
6-7 sym 'a'
7-8 paren_close ')'
8-22 lit_contents ' interpolated.'
22-23 sq "'"

'"dq \\(a) interpolated."':
0-1 dq '"'
1-4 lit_contents 'dq '
4-6 lit_interpolate '\\('
6-7 sym 'a'
7-8 paren_close ')'
8-22 lit_contents ' interpolated.'
22-23 dq '"'

'\'sq \\(nested "interpolated \\(a)").\'':
0-1 sq "'"
1-4 lit_contents 'sq '
4-6 lit_interpolate '\\('
6-12 sym 'nested'
12-13 spaces ' '
13-14 dq '"'
14-27 lit_contents 'interpolated '
27-29 lit_interpolate '\\('
29-30 sym 'a'
30-31 paren_close ')'
31-32 dq '"'
32-33 paren_close ')'
33-34 lit_contents '.'
34-35 sq "'"
