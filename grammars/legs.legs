# Patterns

newline: \n
spaces: \s+
comment: / / $Ascii_Readable*

// A section header is a `#` at the start of a line, followed by a space and the section name.
// This flat grammar cannot express line anchoring; see `legs.parse` for the actual framing rules.
section_label_license:      \# \s License
section_label_patterns:     \# \s Patterns
section_label_modes:        \# \s Modes
section_label_transitions:  \# \s Transitions

sym: $Ascii_Letter [$Ascii_Letter $Ascii_Number _]*
colon: :
brckt_o: \[
brckt_c: \]
//brace_o: \{
//brace_c: \}
paren_o: \(
paren_c: \)
bar: \|
qmark: \?
star: \*
plus: \+
amp: &
dash: -
caret: \^
ref: \$ $Ascii_Letter [$Ascii_Letter $Ascii_Number _]*
esc: \\ $Ascii_Visible // TODO: list escapable characters.
char: [$Ascii_Visible - \# \s $Ascii_Letter]
