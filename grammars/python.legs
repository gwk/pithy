# Patterns

// Python 3.14. Mode coordination and indentation live in legs.py_lexer.
// Non-ASCII name candidates are validated with the running Python Unicode database.
space: [\s \t \f]+
newline: \r \n? | \n
continuation: \\ (\r \n? | \n)
comment: \# [$C $L $M $N $P $S $Z - $Cs \0 - \r \n]*
name: [$Ascii_Letter _ [$C $L $M $N $P $S $Z - $Cs \0 - $Ascii]] [$Ascii_Letter $Dec _ [$C $L $M $N $P $S $Z - $Cs \0 -
  $Ascii]]*
number: 0 [x X] (_? $Hex)+ | 0 [o O] (_? $Oct)+ | 0 [b B] (_? $Bin)+ | ($Dec (_? $Dec)* . ($Dec (_? $Dec)*)? | . $Dec (_?
  $Dec)*) ([e E] [\+ \-]? $Dec (_? $Dec)*)? [j J]? | $Dec (_? $Dec)* [e E] [\+ \-]? $Dec (_? $Dec)* [j J]? | $Dec (_? $Dec)* [j
  J]?
op: \*\*= | / /= | <<= | >>= | == | != | <= | >= | := | -> | \+= | -= | \*= | /= | %= | @= | &= | \|= | \^= | \*\* | / / | << |
  >> | ... | [\+ \- \* / % @ \& \| \^ ~ < > = : ; , . !]
paren_o: \(
paren_c: \)
brack_o: \[
brack_c: \]
brace_o: {
brace_c: }
brace_escape_o: {{
brace_escape_c: }}
escape_simple: \\ [\\ ' " a b f n r t v]
escape_octal: \\ $Oct $Oct? $Oct?
escape_hex: \\ x $Hex $Hex
escape_u: \\ u $Hex $Hex $Hex $Hex
escape_U: \\ U $Hex $Hex $Hex $Hex $Hex $Hex $Hex $Hex
escape_named: \\ N { [$Ascii_Letter $Dec \s \-]+ }
escape_newline: \\ (\r \n? | \n)
escape_unknown: \\ [$C $L $M $N $P $S $Z - $Cs \0 - \\ ' " a b f n r t v $Oct x u U N \r \n { }]
escape_bytes_unknown: \\ [$C $L $M $N $P $S $Z - $Cs \0 - \\ ' " a b f n r t v $Oct x \r \n]
escape_raw: \\ ([$C $L $M $N $P $S $Z - $Cs \0 - \r \n { }] | \r \n? | \n)
escape_brace: \\ [{ }]

quote_s: '
str_s_open: [u U]? '
raw_s_open: [r R] '
bytes_s_open: [b B] '
rawbytes_s_open: ([b B] [r R] | [r R] [b B]) '
f_s_open: [f F] '
fr_s_open: ([f F] [r R] | [r R] [f F]) '
t_s_open: [t T] '
tr_s_open: ([t T] [r R] | [r R] [t T]) '
str_s_text: [$C $L $M $N $P $S $Z - $Cs \0 - ' \\ \r \n]+
raw_s_text: [$C $L $M $N $P $S $Z - $Cs \0 - ' \\ \r \n]+
bytes_s_text: [$C $L $M $N $P $S $Z - $Cs \0 - ' \\ \r \n]+
f_s_text: [$C $L $M $N $P $S $Z - $Cs \0 - ' \\ \r \n { }]+
fr_s_text: [$C $L $M $N $P $S $Z - $Cs \0 - ' \\ \r \n { }]+
fmt_s_text: [$C $L $M $N $P $S $Z - $Cs \0 - ' \\ \r \n { }]+
fmtr_s_text: [$C $L $M $N $P $S $Z - $Cs \0 - ' \\ \r \n { }]+

quote_d: "
str_d_open: [u U]? "
raw_d_open: [r R] "
bytes_d_open: [b B] "
rawbytes_d_open: ([b B] [r R] | [r R] [b B]) "
f_d_open: [f F] "
fr_d_open: ([f F] [r R] | [r R] [f F]) "
t_d_open: [t T] "
tr_d_open: ([t T] [r R] | [r R] [t T]) "
str_d_text: [$C $L $M $N $P $S $Z - $Cs \0 - " \\ \r \n]+
raw_d_text: [$C $L $M $N $P $S $Z - $Cs \0 - " \\ \r \n]+
bytes_d_text: [$C $L $M $N $P $S $Z - $Cs \0 - " \\ \r \n]+
f_d_text: [$C $L $M $N $P $S $Z - $Cs \0 - " \\ \r \n { }]+
fr_d_text: [$C $L $M $N $P $S $Z - $Cs \0 - " \\ \r \n { }]+
fmt_d_text: [$C $L $M $N $P $S $Z - $Cs \0 - " \\ \r \n { }]+
fmtr_d_text: [$C $L $M $N $P $S $Z - $Cs \0 - " \\ \r \n { }]+

quote_sss: '''
str_sss_open: [u U]? '''
raw_sss_open: [r R] '''
bytes_sss_open: [b B] '''
rawbytes_sss_open: ([b B] [r R] | [r R] [b B]) '''
f_sss_open: [f F] '''
fr_sss_open: ([f F] [r R] | [r R] [f F]) '''
t_sss_open: [t T] '''
tr_sss_open: ([t T] [r R] | [r R] [t T]) '''
str_sss_text: [$C $L $M $N $P $S $Z - $Cs \0 - ' \\]+
raw_sss_text: [$C $L $M $N $P $S $Z - $Cs \0 - ' \\]+
bytes_sss_text: [$C $L $M $N $P $S $Z - $Cs \0 - ' \\]+
f_sss_text: [$C $L $M $N $P $S $Z - $Cs \0 - ' \\ { }]+
fr_sss_text: [$C $L $M $N $P $S $Z - $Cs \0 - ' \\ { }]+
fmt_sss_text: [$C $L $M $N $P $S $Z - $Cs \0 - ' \\ { }]+
fmtr_sss_text: [$C $L $M $N $P $S $Z - $Cs \0 - ' \\ { }]+

quote_ddd: """
str_ddd_open: [u U]? """
raw_ddd_open: [r R] """
bytes_ddd_open: [b B] """
rawbytes_ddd_open: ([b B] [r R] | [r R] [b B]) """
f_ddd_open: [f F] """
fr_ddd_open: ([f F] [r R] | [r R] [f F]) """
t_ddd_open: [t T] """
tr_ddd_open: ([t T] [r R] | [r R] [t T]) """
str_ddd_text: [$C $L $M $N $P $S $Z - $Cs \0 - " \\]+
raw_ddd_text: [$C $L $M $N $P $S $Z - $Cs \0 - " \\]+
bytes_ddd_text: [$C $L $M $N $P $S $Z - $Cs \0 - " \\]+
f_ddd_text: [$C $L $M $N $P $S $Z - $Cs \0 - " \\ { }]+
fr_ddd_text: [$C $L $M $N $P $S $Z - $Cs \0 - " \\ { }]+
fmt_ddd_text: [$C $L $M $N $P $S $Z - $Cs \0 - " \\ { }]+
fmtr_ddd_text: [$C $L $M $N $P $S $Z - $Cs \0 - " \\ { }]+

# Modes

main: space newline continuation comment name number op paren_o paren_c brack_o brack_c brace_o brace_c
  str_s_open raw_s_open bytes_s_open rawbytes_s_open f_s_open fr_s_open t_s_open tr_s_open str_d_open raw_d_open bytes_d_open
  rawbytes_d_open f_d_open fr_d_open t_d_open tr_d_open str_sss_open raw_sss_open bytes_sss_open rawbytes_sss_open f_sss_open
  fr_sss_open t_sss_open tr_sss_open str_ddd_open raw_ddd_open bytes_ddd_open rawbytes_ddd_open f_ddd_open fr_ddd_open
  t_ddd_open tr_ddd_open

str_s: str_s_text quote_s newline escape_simple escape_octal escape_hex escape_newline escape_u escape_U escape_named
  escape_unknown escape_brace
raw_s: raw_s_text quote_s newline escape_raw escape_brace
bytes_s: bytes_s_text quote_s newline escape_simple escape_octal escape_hex escape_newline escape_bytes_unknown
f_s: f_s_text quote_s newline escape_simple escape_octal escape_hex escape_newline escape_u escape_U escape_named
  escape_unknown brace_o brace_c brace_escape_o brace_escape_c
fr_s: fr_s_text quote_s newline escape_raw brace_o brace_c brace_escape_o brace_escape_c
fmt_s: fmt_s_text quote_s newline escape_simple escape_octal escape_hex escape_newline escape_u escape_U escape_named
  escape_unknown brace_o brace_c
fmtr_s: fmtr_s_text quote_s newline escape_raw brace_o brace_c
str_d: str_d_text quote_d newline escape_simple escape_octal escape_hex escape_newline escape_u escape_U escape_named
  escape_unknown escape_brace
raw_d: raw_d_text quote_d newline escape_raw escape_brace
bytes_d: bytes_d_text quote_d newline escape_simple escape_octal escape_hex escape_newline escape_bytes_unknown
f_d: f_d_text quote_d newline escape_simple escape_octal escape_hex escape_newline escape_u escape_U escape_named
  escape_unknown brace_o brace_c brace_escape_o brace_escape_c
fr_d: fr_d_text quote_d newline escape_raw brace_o brace_c brace_escape_o brace_escape_c
fmt_d: fmt_d_text quote_d newline escape_simple escape_octal escape_hex escape_newline escape_u escape_U escape_named
  escape_unknown brace_o brace_c
fmtr_d: fmtr_d_text quote_d newline escape_raw brace_o brace_c
str_sss: str_sss_text quote_sss quote_s escape_simple escape_octal escape_hex escape_newline escape_u escape_U escape_named
  escape_unknown escape_brace
raw_sss: raw_sss_text quote_sss quote_s escape_raw escape_brace
bytes_sss: bytes_sss_text quote_sss quote_s escape_simple escape_octal escape_hex escape_newline escape_bytes_unknown
f_sss: f_sss_text quote_sss quote_s escape_simple escape_octal escape_hex escape_newline escape_u escape_U escape_named
  escape_unknown brace_o brace_c brace_escape_o brace_escape_c
fr_sss: fr_sss_text quote_sss quote_s escape_raw brace_o brace_c brace_escape_o brace_escape_c
fmt_sss: fmt_sss_text quote_sss quote_s escape_simple escape_octal escape_hex escape_newline escape_u escape_U escape_named
  escape_unknown brace_o brace_c
fmtr_sss: fmtr_sss_text quote_sss quote_s escape_raw brace_o brace_c
str_ddd: str_ddd_text quote_ddd quote_d escape_simple escape_octal escape_hex escape_newline escape_u escape_U escape_named
  escape_unknown escape_brace
raw_ddd: raw_ddd_text quote_ddd quote_d escape_raw escape_brace
bytes_ddd: bytes_ddd_text quote_ddd quote_d escape_simple escape_octal escape_hex escape_newline escape_bytes_unknown
f_ddd: f_ddd_text quote_ddd quote_d escape_simple escape_octal escape_hex escape_newline escape_u escape_U escape_named
  escape_unknown brace_o brace_c brace_escape_o brace_escape_c
fr_ddd: fr_ddd_text quote_ddd quote_d escape_raw brace_o brace_c brace_escape_o brace_escape_c
fmt_ddd: fmt_ddd_text quote_ddd quote_d escape_simple escape_octal escape_hex escape_newline escape_u escape_U escape_named
  escape_unknown brace_o brace_c
fmtr_ddd: fmtr_ddd_text quote_ddd quote_d escape_raw brace_o brace_c

// The Python coordinator manages these modes, including replacement fields and format specifications.
// No static transition can express all of Python's context-dependent mode changes.
