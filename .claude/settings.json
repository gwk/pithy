{
  "permissions": {
    "defaultMode": "auto",
    "allow": [
      "Edit",
      "Monitor",
      "WebFetch",
      "WebSearch",
      "Write"

    ],
    "additionalDirectories": []
  },
  "sandbox": {
    "enabled": true,
    "failIfUnavailable": true,
    "autoAllowBashIfSandboxed": true,
    "allowUnsandboxedCommands": false,
    "fileSystem": {
      "allowRead": []
    },
    "network": {
      "allowLocalBinding": true
    }
  }
}
