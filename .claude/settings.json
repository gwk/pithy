{
  "permissions": {
    "defaultMode": "auto",
    "allow": [
      "Bash(git --no-pager status:*)",
      "Bash(git status:*)",
      "Bash(just:*)",
      "Edit",
      "Monitor",
      "WebSearch",
      "Write"
    ],
    "additionalDirectories": []
  },
  "sandbox": {
    "enabled": true,
    "failIfUnavailable": true,
    "autoAllowBashIfSandboxed": true,
    "allowUnsandboxedCommands": false,
    "fileSystem": {
      "allowRead": []
    },
    "network": {
      "allowLocalBinding": true
    }
  }
}
