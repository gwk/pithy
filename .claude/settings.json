{
  "permissions": {
    "allow": [
      "Bash(echo:*)",
      "Bash(git:*)",
      "Bash(iotest:*)",
      "Bash(just check:*)",
      "Bash(just isort:*)",
      "Bash(just lint:*)",
      "Bash(just test:*)",
      "Bash(just typecheck:*)",
      "Bash(just utest:*)",
      "Bash(mypy:*)",
      "Bash(python -m utest:*)",
      "Bash(python:*)"
    ]
  },
  "sandbox": {
    "enabled": true,
    "autoAllowBashIfSandboxed": true,
    "allowUnsandboxedCommands": false,
    "network": {
      "allowLocalBinding": true
    }
  }
}
